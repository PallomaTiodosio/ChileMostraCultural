@{
    ViewData["Title"] = "Cultura do Chile";
}

<section class="hero hero--cultura">
    <div class="hero-overlay hero-overlay--left">
        <h1 class="hero-title hero-title--menor">CULTURA DO CHILE</h1>
        <p class="hero-subtitle">Costumes, música, dança e tradições que contam a história do povo chileno.</p>
        <a class="btn btn-primary" asp-controller="Historia" asp-action="Index">Conheça mais</a>
    </div>
</section>

<section class="content-block">
    <h2>Tradições vivas</h2>
    <p>
        A cultura chilena mistura influências indígenas, como os povos Mapuche, com heranças
        espanholas e europeias. Festas populares, a cueca (dança nacional) e o folclore regional
        são parte fundamental da identidade do país.
    </p>
</section>