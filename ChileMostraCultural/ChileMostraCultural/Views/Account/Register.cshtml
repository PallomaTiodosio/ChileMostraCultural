@model RegisterViewModel
@{
    ViewData["Title"] = "Criar conta";
    Layout = "_Layout";
}

<div class="auth-split">
    <div class="auth-image auth-image--register">
        <div class="auth-image-overlay">
            <h1>CONHEÇA O CHILE!</h1>
            <p>Crie sua conta e tenha acesso a informações, curiosidades, dicas sobre o Chile e muito mais.</p>
        </div>
    </div>

    <div class="auth-form-side">
        <div class="auth-form-wrap">
            <h2>Criar conta</h2>
            <p class="auth-subtitle">Preencha os dados abaixo para se cadastrar.</p>

            <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-group">
                    <label asp-for="NomeCompleto">Nome completo*</label>
                    <input asp-for="NomeCompleto" class="form-control" placeholder="Seu nome completo" />
                    <span asp-validation-for="NomeCompleto" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">E-mail*</label>
                    <input asp-for="Email" class="form-control" placeholder="seu@email.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Telefone">Telefone*</label>
                    <input asp-for="Telefone" class="form-control" placeholder="(11) 99999-9999" />
                    <span asp-validation-for="Telefone" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Senha">Senha*</label>
                    <div class="input-password">
                        <input asp-for="Senha" type="password" class="form-control" placeholder="Mínimo 6 caracteres" id="senhaCadastro" />
                        <button type="button" class="toggle-password" data-target="senhaCadastro">👁</button>
                    </div>
                    <span asp-validation-for="Senha" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmarSenha">Confirmar senha*</label>
                    <input asp-for="ConfirmarSenha" type="password" class="form-control" placeholder="Repita a senha" />
                    <span asp-validation-for="ConfirmarSenha" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Criar conta</button>

                <p class="auth-switch">
                    Já tem conta? <a asp-controller="Account" asp-action="Login">Entrar</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}