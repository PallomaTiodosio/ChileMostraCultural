<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChileMostraCultural</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar">
        <div class="navbar-inner">
            <a class="logo" asp-controller="Home" asp-action="Index">VIVA<span>CHILE</span></a>

            <button class="nav-toggle" id="navToggle" aria-label="Abrir menu">
                <span></span><span></span><span></span>
            </button>

            <nav class="nav-links" id="navLinks">
                <a asp-controller="Home" asp-action="Index">Início</a>
                <a asp-controller="Home" asp-action="SobreChile">Sobre o Chile</a>
                <a asp-controller="Historia" asp-action="Index">História</a>
                <a asp-controller="Cultura" asp-action="Index">Cultura</a>
                <a asp-controller="Home" asp-action="PontosTuristicos">Pontos Turísticos</a>
                <a asp-controller="Galeria" asp-action="Index">Galeria</a>
            </nav>

            <div class="navbar-actions">
                @if (Context.Session.GetString("UsuarioNome") is string nome)
                {
                    <span class="user-greeting">Olá, @nome</span>
                    <a class="btn btn-outline-light" asp-controller="Account" asp-action="Logout">Sair</a>
                }
                else
                {
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>
        </div>
    </header>

    @if (TempData["Mensagem"] != null)
    {
        <div class="alert-flash">@TempData["Mensagem"]</div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>&copy; @DateTime.Now.Year ChileMostraCultural — Conheça as maravilhas do Chile.</p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>