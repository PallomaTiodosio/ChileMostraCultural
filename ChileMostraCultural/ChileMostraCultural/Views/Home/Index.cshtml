@{
    ViewData["Title"] = "Início";
}

<section class="hero" style="background-image:linear-gradient(180deg, rgba(10,20,40,0.55) 0%, rgba(10,20,40,0.75) 100%), url('/images/destinos/hero-inicio.png'); background-size:cover; background-position:center;">
    <div class="hero-overlay">
        <p class="hero-eyebrow">DESCUBRA O</p>
        <h1 class="hero-title">CHILE</h1>
        <p class="hero-subtitle">Entre desertos, montanhas e oceanos.</p>
    </div>
</section>

<section class="features">
    <div class="feature-card">
        <span class="feature-icon">🏔️</span>
        <div>
            <strong>Natureza</strong>
            <p>Paisagens únicas de norte a sul</p>
        </div>
    </div>
    <div class="feature-card">
        <span class="feature-icon">📖</span>
        <div>
            <strong>História</strong>
            <p>Séculos de tradição e cultura</p>
        </div>
    </div>
    <div class="feature-card">
        <span class="feature-icon">🎒</span>
        <div>
            <strong>Aventura</strong>
            <p>Trilhas, vulcões e glaciares</p>
        </div>
    </div>
    <div class="feature-card">
        <span class="feature-icon">🍷</span>
        <div>
            <strong>Gastronomia</strong>
            <p>Sabores e vinhos premiados</p>
        </div>
    </div>
</section>

<section class="destaque">
    <div class="destaque-imagem" style="background-image:url('/images/destinos/torres-del-paine.jpg'); background-size:cover; background-position:center;"></div>
    <div class="destaque-texto">
        <h3>Torres del Paine</h3>
        <p class="destaque-local">Patagônia Chilena</p>
        <p>
            Um dos parques nacionais mais espetaculares da América do Sul, com montanhas
            de granito, geleiras e lagos de tons intensos que encantam viajantes do mundo todo.
        </p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="PontosTuristicos">Ver todos os destinos</a>
    </div>
</section>

<section class="territorio">
    <div class="territorio-mapa" style="background-image:url('/images/destinos/territorio-mapa.jpg'); background-size:cover; background-position:center;"></div>
    <div class="territorio-texto">
        <h3>TERRITÓRIO DO <span class="destaque-chile">CHILE</span></h3>
        <p>
            Localizado na América do Sul, o Chile se estende por uma estreita faixa de terra
            entre a Cordilheira dos Andes e o Oceano Pacífico, reunindo paisagens que vão do
            deserto mais árido do mundo às geleiras da Patagônia.
        </p>
        <p>
            Essa diversidade geográfica faz do país um destino único, com climas, culturas e
            biomas completamente diferentes de norte a sul.
        </p>
    </div>
</section>